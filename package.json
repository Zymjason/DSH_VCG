{
  "name": "@local/dsh-vcg",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "VCG 视觉控制生成器 (Visual Control Generator) — 节点式图像/视频生成工作流画布：聊天 VCG 画布模式、VCG 项目工作区、AI 自动组建工作流、云端 DeepSeek Harness API 生图/生视频，可选本地 ComfyUI 运算。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "nodes/*.json",
    "workflows/*.json",
    "docs/*.md",
    "scripts/*.mjs",
    "build.mjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node scripts/self-test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zymjason/DSH_VCG.git"
  },
  "homepage": "https://github.com/Zymjason/DSH_VCG",
  "license": "MIT"
}
